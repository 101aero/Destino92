  end
  object btnOpcion3: TButton
    Position.X = 435
    Position.Y = 144
    Size.Width = 195
    Size.Height = 42
    Anchors = [akTop, akRight]
    Text = 'Opcion 3'
    OnClick = btnOpcion3Click
  end
  object lblInventario: TLabel
    Position.X = 435
    Position.Y = 198
    Size.Width = 195
    Size.Height = 24
    Anchors = [akTop, akRight]
    Text = 'INVENTARIO'
    TextSettings.Font.Size = 14
  end
  object lstInventario: TListBox
    Position.X = 435
    Position.Y = 224
    Size.Width = 195
    Size.Height = 78
