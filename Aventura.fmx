    TextSettings.Font.Size = 17
  end
  object lblFecha: TLabel
    Position.X = 230
    Position.Y = 6
    Size.Width = 180
    Size.Height = 26
    Text = '2026'
    TextSettings.Font.Size = 17
    TextSettings.HorzAlign = Center
  end
  object lblEscena: TLabel
    Position.X = 455
    Position.Y = 6
    Size.Width = 170
    Size.Height = 26
    Text = 'ESCENA 1'
    TextSettings.Font.Size = 15
    TextSettings.HorzAlign = Trailing
  end
  object memHistoria: TMemo
    Position.X = 10
    Position.Y = 42
    Size.Width = 410
    Size.Height = 308
    Anchors = [akLeft, akTop, akRight, akBottom]
    ReadOnly = True
    WordWrap = True
    TextSettings.Font.Size = 15
  end
  object btnOpcion1: TButton
    Position.X = 435
    Position.Y = 48
    Size.Width = 195
    Size.Height = 42
    Anchors = [akTop, akRight]
